# auto-overnight.env — copy to config/auto-overnight.env and fill in.
# This file is the COMMITTED placeholder. The real config/auto-overnight.env
# is gitignored and lives only on alphabot.

# Email provider — only `resend` is wired today. msmtp is the documented fallback.
EMAIL_PROVIDER=resend

# Resend API key (https://resend.com/api-keys). REQUIRED.
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX

# Sender address. Use onboarding@resend.dev until sprout.co.id DNS is verified,
# then switch to e.g. research@sprout.co.id.
RESEND_FROM=onboarding@resend.dev
RESEND_FROM_NAME=Overnight Research

# Recipients list (one email per line, # comments allowed).
RECIPIENTS_FILE=/Users/alphabot/Downloads/Work/overnight-research-repo/config/recipients.txt

# Hard cap on the whole night (hours). If reached mid-queue, remaining topics
# are deferred to the next 23:00 run.
NIGHTLY_CAP_HOURS=12

# Optional override for repo dir; defaults to scripts/.. of the script path.
REPO_DIR=/Users/alphabot/Downloads/Work/overnight-research-repo
