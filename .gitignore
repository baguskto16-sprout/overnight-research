# Run outputs — COMMITTED to canonical Wright-Partners repo so Chiara / Toi
# can review run results directly. `.gitkeep` kept as a safety placeholder.
!output/raw-claude-overnight/.gitkeep

# Cache (machine-local, not committed)
.claude/cache/sources/*.html
.claude/cache/sources/*.md
.claude/cache/sources/*.txt
.claude/cache/sources/index.json
.claude/cache/sources/*.tmp

# Logs
*.log
.last-run.pid
.smoke-test.pid

# WP-confidential references (loaded via setup.sh from private repos)
.claude/refs/*.md
!.claude/refs/.gitkeep

# OS junk
.DS_Store
Thumbs.db

# Auto-resume + watchdog runtime pids
.resume.pid
.watchdog.pid
.resume-scheduler.pid
.last-run.txt

# Secrets — never commit
.keychain-pass
.unattended.pid
.render.pid
.playwright-mcp/
config/auto-overnight.env
*.run.lock

# Scheduler runtime
logs/
auto-overnight-implementation-report.md
.claude/plans/
